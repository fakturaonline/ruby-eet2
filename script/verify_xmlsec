# frozen_string_literal: true

require "base64"
require "bigdecimal"
require "nokogiri"
require "open3"
require "openssl"
require "tmpdir"

require_relative "../lib/eet2"

ROOT = File.expand_path("..", __dir__)
SOAP_BODY_NAME = "#{Eet2::XmlSigner::SOAP_NAMESPACE}:Body"
NAMESPACES = {"wsse" => Eet2::XmlSigner::WSSE_NAMESPACE}.freeze

def test_credential
  key = OpenSSL::PKey::RSA.generate(2048)
  certificate = OpenSSL::X509::Certificate.new
  certificate.version = 2
  certificate.serial = 1
  certificate.subject = OpenSSL::X509::Name.parse("/C=CZ/O=EET2 xmlsec oracle/CN=CZ00000019")
  certificate.issuer = certificate.subject
  certificate.public_key = key.public_key
  certificate.not_before = Time.utc(2026, 1, 1)
  certificate.not_after = Time.utc(2030, 1, 1)
  certificate.sign(key, OpenSSL::Digest::SHA256.new)

  Eet2::Credential.new(
    certificate: certificate,
    signer: Eet2::LocalKeySigner.new(private_key: key)
  )
end

def generated_request
  credential = test_credential
  sale = Eet2::Sale.new(
    taxpayer_eic: "CZ00000019",
    evidence_unit_id: 303,
    register_id: "xmlsec-1",
    sequence_number: "oracle/2027/1",
    occurred_at: Time.utc(2027, 1, 3, 11, 30, 45),
    amount_czk: BigDecimal("1250.00")
  )
  builder = Eet2::Contracts::V4_1::RequestBuilder.new(
    credential: credential,
    uuid_generator: -> { "123e4567-e89b-42d3-a456-426614174000" },
    clock: -> { Time.utc(2027, 1, 3, 11, 31, 2) }
  )

  builder.call(sale: sale, first_submission: true).xml
end

def verify_with_xmlsec!(xmlsec, xml_path, certificate_path)
  stdout, stderr, status = Open3.capture3(
    xmlsec,
    "--verify",
    "--lax-key-search",
    "--pubkey-cert-pem",
    certificate_path,
    "--id-attr:Id",
    SOAP_BODY_NAME,
    xml_path
  )
  return if status.success?

  abort "xmlsec1 rejected #{File.basename(xml_path)}:\n#{stdout}#{stderr}"
end

xmlsec = ENV.fetch("XMLSEC1", "xmlsec1")
_version_stdout, version_stderr, version_status = Open3.capture3(xmlsec, "--version")
abort "xmlsec1 is required for interoperability verification: #{version_stderr}" unless version_status.success?

official_requests = Dir[File.join(ROOT, "spec/fixtures/official/eet-v4_1/*.xml")].sort
abort "expected three official request fixtures" unless official_requests.length == 3
accepted_response = File.join(ROOT, "spec/fixtures/responses/playground/accepted-live-2026-07-21.xml")
abort "expected captured signed response fixture" unless File.file?(accepted_response)

Dir.mktmpdir("eet2-xmlsec") do |temporary_directory|
  generated_path = File.join(temporary_directory, "ruby-generated.xml")
  File.binwrite(generated_path, generated_request)

  (official_requests + [generated_path, accepted_response]).each_with_index do |xml_path, index|
    document = Nokogiri::XML::Document.parse(File.binread(xml_path)) { |config| config.strict.nonet }
    token = document.at_xpath("//wsse:BinarySecurityToken", NAMESPACES)
    abort "missing BinarySecurityToken in #{File.basename(xml_path)}" unless token

    certificate = OpenSSL::X509::Certificate.new(Base64.strict_decode64(token.text))
    certificate_path = File.join(temporary_directory, "certificate-#{index}.pem")
    File.binwrite(certificate_path, certificate.to_pem)
    verify_with_xmlsec!(xmlsec, xml_path, certificate_path)
  end
end

puts "xmlsec1 independently verified 3 official requests, 1 Ruby-generated request, and 1 Playground response signature."
